// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdSessions   PrayerSession[] @relation("CreatedSessions")
  attendingSessionIds String[]     @db.ObjectId
  attendingSessions PrayerSession[] @relation("Attendees", fields: [attendingSessionIds], references: [id])
}

model Location {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  address       String
  type          LocationType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      PrayerSession[]
}

model PrayerSession {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  datetime      DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation("CreatedSessions", fields: [createdById], references: [id])
  createdById   String        @db.ObjectId
  location      Location      @relation(fields: [locationId], references: [id])
  locationId    String        @db.ObjectId
  attendeeIds   String[]     @db.ObjectId
  attendees     User[]       @relation("Attendees", fields: [attendeeIds], references: [id])
  maxAttendees  Int?
  notes         String?
}

enum LocationType {
  MOSQUE
  PRAYER_ROOM
  OTHER
}
